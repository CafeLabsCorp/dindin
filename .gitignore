# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Flutter/Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
*.g.dart
*.freezed.dart
android/local.properties
android/**/gradle-wrapper.jar
android/.gradle
windows/flutter/generated_plugin*
web/firebase-config.js
ios/Flutter/flutter_export_environment.sh
flutter_0*.log

# --- IDE ---
.idea/
*.iml

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# --- Node (scripts/, functions/, test/rules/) ---
node_modules/

# Firebase admin / service-account keys — never commit
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*-adminsdk-*.json

# --- Android release signing — NEVER commit (this repo is PUBLIC) ------------
# Losing the upload keystore, or leaking it, is not recoverable by editing code:
# see docs/DEPLOY.md, "Android release". The keystore itself is supposed to live
# OUTSIDE this repository entirely; these patterns are a second line of defence
# for the case where someone drops a copy in the working tree by accident.
# (android/.gitignore repeats key.properties/*.jks/*.keystore for the same
# reason — a belt-and-braces duplication that is intentional, not leftover.)
**/key.properties
*.jks
*.keystore
*.p12
*.pepk

# Release artifacts and Dart symbol files. Normally these land under build/
# (already ignored above), but `--split-debug-info` / a manual copy can put them
# anywhere. Symbol files are NOT secret, but they are also not versioned here —
# they must be archived next to the keystore backup, see docs/DEPLOY.md.
*.aab
*.apk
*.symbols
symbols/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
.vercel
